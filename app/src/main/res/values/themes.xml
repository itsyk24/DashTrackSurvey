<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DashTrack" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#C62828</item>
        <item name="colorPrimaryDark">#8E0000</item>
        <item name="colorAccent">#C62828</item>
        <item name="android:windowBackground">#F4F4F4</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
